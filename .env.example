# ============================================================
# MediKiosk (SIH26047) Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
DEMO_MODE=true

# Frontend Configuration
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Database & Auth (Backend Service Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# AI Services Configuration
# Options: 'gemini' | 'mock' (Default is 'mock' for standalone zero-key execution)
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Security & Sessions
SECRET_KEY=medikiosk-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TIMEOUT_MINUTES=30
