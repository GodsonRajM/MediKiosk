# ==============================================================================
# MediKiosk Backend Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEMO_MODE=true
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SECRET_KEY=medikiosk-development-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_TIMEOUT_MINUTES=30

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# AI Provider: 'mock' for standalone zero-key execution, 'gemini' for Google Gemini
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ABDM_MODE=mock
FHIR_MODE=mock
