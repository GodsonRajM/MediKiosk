# ==============================================================================
# MediKiosk Backend Environment Configuration
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SECRET_KEY=medikiosk-sample-jwt-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Supabase (PostgreSQL, Auth, Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Google Gemini AI
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Interoperability Modes
ABDM_MODE=adapter
FHIR_MODE=adapter