{
  "pathways": {
    "chest_pain": {
      "name": "Chest Discomfort / Pain Pathway",
      "required_fields": [
        "onset",
        "duration",
        "location",
        "severity",
        "character",
        "radiation",
        "aggravating_factors",
        "relieving_factors",
        "associated_symptoms"
      ],
      "questions": [
        {
          "code": "CP_LOCATION",
          "slot": "location",
          "section": "symptom_details",
          "text": "Where exactly do you feel the pain or discomfort?",
          "type": "single_choice",
          "options": [
            {"id": "loc_center", "label": "Center of Chest (Behind breastbone)", "value": "retrosternal"},
            {"id": "loc_left", "label": "Left Side of Chest", "value": "left_chest"},
            {"id": "loc_right", "label": "Right Side of Chest", "value": "right_chest"},
            {"id": "loc_upper_abs", "label": "Upper Abdomen / Epigastric", "value": "epigastric"}
          ]
        },
        {
          "code": "CP_CHARACTER",
          "slot": "character",
          "section": "symptom_details",
          "text": "What does the pain feel like?",
          "type": "single_choice",
          "options": [
            {"id": "char_pressure", "label": "Pressure, Heavy Squeezing or Tightness", "value": "heaviness_pressure"},
            {"id": "char_sharp", "label": "Sharp or Stabbing (worse on deep breath)", "value": "sharp_pleuritic"},
            {"id": "char_burning", "label": "Burning (like acidity)", "value": "burning"},
            {"id": "char_dull", "label": "Dull Ache", "value": "dull_ache"}
          ]
        },
        {
          "code": "CP_SEVERITY",
          "slot": "severity",
          "section": "symptom_details",
          "text": "On a scale of 1 to 10, how severe is the pain right now?",
          "type": "scale",
          "options": [
            {"id": "sev_mild", "label": "Mild (1 - 3)", "value": "mild"},
            {"id": "sev_mod", "label": "Moderate (4 - 6)", "value": "moderate"},
            {"id": "sev_sev", "label": "Severe (7 - 10)", "value": "severe"}
          ]
        },
        {
          "code": "CP_ONSET",
          "slot": "onset",
          "section": "chronology",
          "text": "When did this discomfort start?",
          "type": "single_choice",
          "options": [
            {"id": "on_sudden", "label": "Suddenly today within the last few hours", "value": "hours_ago"},
            {"id": "on_few_days", "label": "Past 1 to 3 days", "value": "2_days_ago"},
            {"id": "on_week", "label": "Over a week ago", "value": "weeks_ago"},
            {"id": "on_chronic", "label": "Intermittently for months", "value": "months_ago"}
          ]
        },
        {
          "code": "CP_RADIATION",
          "slot": "radiation",
          "section": "symptom_details",
          "text": "Does the discomfort spread or radiate anywhere?",
          "type": "multi_choice",
          "options": [
            {"id": "rad_none", "label": "No spreading, stays in one spot", "value": "none"},
            {"id": "rad_left_arm", "label": "Left Arm or Shoulder", "value": "left_arm"},
            {"id": "rad_jaw", "label": "Jaw, Neck or Teeth", "value": "jaw_neck"},
            {"id": "rad_back", "label": "Back between shoulder blades", "value": "back"}
          ]
        },
        {
          "code": "CP_AGGRAVATING",
          "slot": "aggravating_factors",
          "section": "triggers",
          "text": "What makes the pain worse?",
          "type": "multi_choice",
          "options": [
            {"id": "agg_exertion", "label": "Physical effort (walking, stairs)", "value": "exertion"},
            {"id": "agg_breathing", "label": "Taking a deep breath or coughing", "value": "deep_inspiration"},
            {"id": "agg_food", "label": "After eating a heavy meal", "value": "postprandial"},
            {"id": "agg_pressing", "label": "Pressing on the chest wall", "value": "palpation"}
          ]
        },
        {
          "code": "CP_RELIEVING",
          "slot": "relieving_factors",
          "section": "triggers",
          "text": "What makes the pain better or go away?",
          "type": "single_choice",
          "options": [
            {"id": "rel_rest", "label": "Resting or sitting quietly", "value": "rest"},
            {"id": "rel_antacid", "label": "Taking antacids / drinking water", "value": "antacids"},
            {"id": "rel_posture", "label": "Leaning forward", "value": "leaning_forward"},
            {"id": "rel_nothing", "label": "Nothing brings relief", "value": "none"}
          ]
        },
        {
          "code": "CP_ASSOCIATED",
          "slot": "associated_symptoms",
          "section": "associated",
          "text": "Do you feel any of these symptoms alongside the discomfort?",
          "type": "multi_choice",
          "options": [
            {"id": "asc_breathless", "label": "Shortness of breath / Breathlessness", "value": "breathlessness"},
            {"id": "asc_sweat", "label": "Cold sweating / Diaphoresis", "value": "sweating"},
            {"id": "asc_dizzy", "label": "Dizziness or fainting feeling", "value": "dizziness"},
            {"id": "asc_nausea", "label": "Nausea or vomiting", "value": "nausea"},
            {"id": "asc_none", "label": "None of these", "value": "none"}
          ]
        }
      ]
    },
    "fever": {
      "name": "Fever Pathway",
      "required_fields": ["duration", "severity", "chills", "associated_symptoms"],
      "questions": [
        {
          "code": "FEV_DURATION",
          "slot": "duration",
          "section": "symptom_details",
          "text": "How many days have you had a fever?",
          "type": "single_choice",
          "options": [
            {"id": "fev_1_2", "label": "1 - 2 days", "value": "1-2_days"},
            {"id": "fev_3_5", "label": "3 - 5 days", "value": "3-5_days"},
            {"id": "fev_week", "label": "More than a week", "value": "more_than_week"}
          ]
        },
        {
          "code": "FEV_CHILLS",
          "slot": "chills",
          "section": "symptom_details",
          "text": "Is the fever accompanied by shivering or chills?",
          "type": "single_choice",
          "options": [
            {"id": "chl_yes", "label": "Yes, shaking chills", "value": "yes_rigors"},
            {"id": "chl_no", "label": "No shivering", "value": "no"}
          ]
        },
        {
          "code": "FEV_ASSOCIATED",
          "slot": "associated_symptoms",
          "section": "associated",
          "text": "Do you have any other symptoms?",
          "type": "multi_choice",
          "options": [
            {"id": "fa_bodyache", "label": "Severe body ache / joint pain", "value": "bodyache"},
            {"id": "fa_cough", "label": "Cough or throat pain", "value": "cough"},
            {"id": "fa_rash", "label": "Skin rash or bleeding spots", "value": "rash"},
            {"id": "fa_burning_urine", "label": "Burning during urination", "value": "dysuria"}
          ]
        }
      ]
    },
    "cough": {
      "name": "Cough Pathway",
      "required_fields": ["duration", "type", "sputum", "associated_symptoms"],
      "questions": [
        {
          "code": "CGH_DURATION",
          "slot": "duration",
          "section": "symptom_details",
          "text": "How long have you been coughing?",
          "type": "single_choice",
          "options": [
            {"id": "cgh_acute", "label": "Less than 2 weeks", "value": "under_2_weeks"},
            {"id": "cgh_subacute", "label": "2 to 4 weeks", "value": "2-4_weeks"},
            {"id": "cgh_chronic", "label": "More than 4 weeks", "value": "over_4_weeks"}
          ]
        },
        {
          "code": "CGH_TYPE",
          "slot": "type",
          "section": "symptom_details",
          "text": "Is your cough dry or producing phlegm/mucus?",
          "type": "single_choice",
          "options": [
            {"id": "cgh_dry", "label": "Dry, irritating cough", "value": "dry"},
            {"id": "cgh_wet", "label": "Wet cough with phlegm", "value": "productive"},
            {"id": "cgh_blood", "label": "Phlegm with streaks of blood", "value": "hemoptysis"}
          ]
        }
      ]
    },
    "abdominal_pain": {
      "name": "Abdominal Pain Pathway",
      "required_fields": ["location", "onset", "severity", "bowel_changes"],
      "questions": [
        {
          "code": "ABD_LOCATION",
          "slot": "location",
          "section": "symptom_details",
          "text": "Which part of your stomach or belly hurts?",
          "type": "single_choice",
          "options": [
            {"id": "abd_upper_mid", "label": "Upper middle (epigastric)", "value": "epigastric"},
            {"id": "abd_right_lower", "label": "Right lower side", "value": "right_lower_quadrant"},
            {"id": "abd_general", "label": "All over the belly", "value": "generalized"}
          ]
        }
      ]
    },
    "headache": {
      "name": "Headache Pathway",
      "required_fields": ["onset", "location", "severity", "visual_changes"],
      "questions": [
        {
          "code": "HDA_ONSET",
          "slot": "onset",
          "section": "symptom_details",
          "text": "How did this headache start?",
          "type": "single_choice",
          "options": [
            {"id": "hda_thunderclap", "label": "Sudden explosion (worst headache of life in seconds)", "value": "thunderclap"},
            {"id": "hda_gradual", "label": "Gradual buildup over hours or days", "value": "gradual"}
          ]
        }
      ]
    }
  }
}
