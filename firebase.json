{
  "hosting": {
    "site": "medikiosk-50ce2",
    "public": "frontend/out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/emergency/**",
        "destination": "/emergency/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
